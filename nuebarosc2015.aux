\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces  Predicted reconstructed-energy spectrum of 1 $e$-like ring events, and contributions from various true neutrino reaction modes, with oscillations for an exposure of 4.0108$\times $10$^{20}$POT in antineutrino beam mode. The distribution is broken down by the following components: $\mathaccentV {bar}016{\nu }_{\mu } \to \mathaccentV {bar}016{\nu }_e$ signal (green), $\nu _{\mu } \to \nu _e$ background (grey), NC (red) background and background other (blue) components. The spectrum was generated using the BANFF prefit MC templates. The spectrum shown was generated assuming the normal hierarchy, and the oscillation parameters shown in table\nobreakspace  {}\ref  {tab:osc_params_fixed_values_reactor}. \relax }}{11}{figure.caption.5}}
\newlabel{fig:1Re_spectrum_and_components_default_osc_prefit}{{5}{11}{Predicted reconstructed-energy spectrum of 1 $e$-like ring events, and contributions from various true neutrino reaction modes, with oscillations for an exposure of \TotalPot POT in antineutrino beam mode. The distribution is broken down by the following components: $\bar {\nu }_{\mu } \to \bar {\nu }_e$ signal (green), $\nu _{\mu } \to \nu _e$ background (grey), NC (red) background and background other (blue) components. The spectrum was generated using the BANFF prefit MC templates. The spectrum shown was generated assuming the normal hierarchy, and the oscillation parameters shown in table~\ref {tab:osc_params_fixed_values_reactor}. \relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces  Predicted reconstructed-energy spectrum of 1 $e$-like ring events, and contributions from various true neutrino reaction modes, with oscillations for an exposure of 4.0108$\times $10$^{20}$POT in antineutrino beam mode. The distribution is broken down by the following components: $\mathaccentV {bar}016{\nu }_{\mu } \to \mathaccentV {bar}016{\nu }_e$ signal (green), $\nu _{\mu } \to \nu _e$ (grey) background, NC background (red) and background other (blue) components. The spectrum was generated using the BANFF postfit-tuned MC templates. The spectrum shown was generated assuming the normal hierarchy, and the oscillation parameters shown in table\nobreakspace  {}\ref  {tab:osc_params_fixed_values_reactor}. \relax }}{11}{figure.caption.5}}
\newlabel{fig:1Re_spectrum_and_components_default_osc_postfit}{{6}{11}{Predicted reconstructed-energy spectrum of 1 $e$-like ring events, and contributions from various true neutrino reaction modes, with oscillations for an exposure of \TotalPot POT in antineutrino beam mode. The distribution is broken down by the following components: $\bar {\nu }_{\mu } \to \bar {\nu }_e$ signal (green), $\nu _{\mu } \to \nu _e$ (grey) background, NC background (red) and background other (blue) components. The spectrum was generated using the BANFF postfit-tuned MC templates. The spectrum shown was generated assuming the normal hierarchy, and the oscillation parameters shown in table~\ref {tab:osc_params_fixed_values_reactor}. \relax }{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces  Predicted contributions to reconstructed-energy spectrum of 1 $e$-like ring events. The contributions are from various true neutrino reaction modes with oscillations for an exposure of 4.0108$\times $10$^{20}$POT in antineutrino beam mode. The following components, area normalized, are shown separately: $\mathaccentV {bar}016{\nu }_{\mu } \to \mathaccentV {bar}016{\nu }_e$ signal (green), $\nu _{\mu } \to \nu _e$ (grey) background, NC background (red) and background other (blue) components. The spectrum was generated using the BANFF prefit-tuned MC templates. The spectrum shown was generated assuming the normal hierarchy, and the oscillation parameters shown in table\nobreakspace  {}\ref  {tab:osc_params_fixed_values_reactor}. \relax }}{11}{figure.caption.6}}
\newlabel{fig:1Re_spectrum_and_components_default_osc_prefit_norm}{{7}{11}{Predicted contributions to reconstructed-energy spectrum of 1 $e$-like ring events. The contributions are from various true neutrino reaction modes with oscillations for an exposure of \TotalPot POT in antineutrino beam mode. The following components, area normalized, are shown separately: $\bar {\nu }_{\mu } \to \bar {\nu }_e$ signal (green), $\nu _{\mu } \to \nu _e$ (grey) background, NC background (red) and background other (blue) components. The spectrum was generated using the BANFF prefit-tuned MC templates. The spectrum shown was generated assuming the normal hierarchy, and the oscillation parameters shown in table~\ref {tab:osc_params_fixed_values_reactor}. \relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces  Predicted contributions to reconstructed-energy spectrum of 1 $e$-like ring events. The contributions are from various true neutrino reaction modes with oscillations for an exposure of 4.0108$\times $10$^{20}$POT in antineutrino beam mode. The following components, area normalized, are shown separately: $\mathaccentV {bar}016{\nu }_{\mu } \to \mathaccentV {bar}016{\nu }_e$ signal (green), $\nu _{\mu } \to \nu _e$ (grey) background, NC background (red) and background other (blue) components. The spectrum was generated using the BANFF postfit-tuned MC templates. The spectrum shown was generated assuming the normal hierarchy, and the oscillation parameters shown in table\nobreakspace  {}\ref  {tab:osc_params_fixed_values_reactor}. \relax }}{11}{figure.caption.6}}
\newlabel{fig:1Re_spectrum_and_components_default_osc_postfit_norm}{{8}{11}{Predicted contributions to reconstructed-energy spectrum of 1 $e$-like ring events. The contributions are from various true neutrino reaction modes with oscillations for an exposure of \TotalPot POT in antineutrino beam mode. The following components, area normalized, are shown separately: $\bar {\nu }_{\mu } \to \bar {\nu }_e$ signal (green), $\nu _{\mu } \to \nu _e$ (grey) background, NC background (red) and background other (blue) components. The spectrum was generated using the BANFF postfit-tuned MC templates. The spectrum shown was generated assuming the normal hierarchy, and the oscillation parameters shown in table~\ref {tab:osc_params_fixed_values_reactor}. \relax }{figure.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces  Top: Reconstructed-energy spectrum of 1 $e$-like ring events, for an exposure of 4.0108$\times $10$^{20}$POT in antineutrino beam mode both with and without the effect of the NA61 flux tuning of the nominal MC templates. The spectra are shown both for no oscillations (left) and for oscillations assuming the normal hierarchy, and the oscillation parameters shown in table\nobreakspace  {}\ref  {tab:osc_params_fixed_values_reactor}. Bottom: Ratio of flux-tuned spectrum to the nominal MC spectrum. \relax }}{12}{figure.caption.7}}
\newlabel{fig:1Re_spectrum_w_and_wo_na61_weights}{{9}{12}{Top: Reconstructed-energy spectrum of 1 $e$-like ring events, for an exposure of \TotalPot POT in antineutrino beam mode both with and without the effect of the NA61 flux tuning of the nominal MC templates. The spectra are shown both for no oscillations (left) and for oscillations assuming the normal hierarchy, and the oscillation parameters shown in table~\ref {tab:osc_params_fixed_values_reactor}. Bottom: Ratio of flux-tuned spectrum to the nominal MC spectrum. \relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces  Top: Reconstructed-energy spectrum of 1 $e$-like ring events, for an exposure of 4.0108$\times $10$^{20}$POT in antineutrino beam mode both with and without the effect of postfit BANFF flux and cross-section tuning on the NA61-tuned flux MC templates. The spectra are shown both for no oscillations (left) and for oscillations assuming the normal hierarchy, and the oscillation parameters shown in table\nobreakspace  {}\ref  {tab:osc_params_fixed_values_reactor}. Bottom: Ratio of BANFF-tuned spectrum to the flux-tuned spectrum. \relax }}{13}{figure.caption.8}}
\newlabel{fig:1Re_spectrum_w_and_wo_banff_weights}{{10}{13}{Top: Reconstructed-energy spectrum of 1 $e$-like ring events, for an exposure of \TotalPot POT in antineutrino beam mode both with and without the effect of postfit BANFF flux and cross-section tuning on the NA61-tuned flux MC templates. The spectra are shown both for no oscillations (left) and for oscillations assuming the normal hierarchy, and the oscillation parameters shown in table~\ref {tab:osc_params_fixed_values_reactor}. Bottom: Ratio of BANFF-tuned spectrum to the flux-tuned spectrum. \relax }{figure.caption.8}{}}
