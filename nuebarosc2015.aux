\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces  Calculated predicted numbers of 1-ring $e$-like events without oscillations using the nominal MC templates, the NA61-tuned MC templates, the NIWG-tuned MC templates and the BANFF-tuned MC templates. The BANFF prefit column is the NA61 tuned data, with the CCQE samples reweighted according to the NIWG's external data fits\nobreakspace  {}\cite  {NIWGCCQE}. The total numbers of events and the numbers of events from each mode considered in this analysis are shown. These numbers were calculated for an exposure of 4.0108$\times $10$^{20}$POT. \relax }}{7}{table.caption.2}}
\newlabel{tab:nsk_nominal_no_osc}{{2}{7}{Calculated predicted numbers of 1-ring $e$-like events without oscillations using the nominal MC templates, the NA61-tuned MC templates, the NIWG-tuned MC templates and the BANFF-tuned MC templates. The BANFF prefit column is the NA61 tuned data, with the CCQE samples reweighted according to the NIWG's external data fits~\cite {NIWGCCQE}. The total numbers of events and the numbers of events from each mode considered in this analysis are shown. These numbers were calculated for an exposure of \TotalPot POT. \relax }{table.caption.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces  Calculated predicted numbers of 1-ring $e$-like events with oscillations using the nominal MC templates, the NA61-tuned MC templates, the NIWG-tuned MC templates and the BANFF-tuned MC templates. The BANFF prefit column is the NA61 tuned data, with the CCQE samples reweighted according to the NIWG's external data fits\nobreakspace  {}\cite  {NIWGCCQE}. The total numbers of events and the numbers of events from each mode considered in this analysis are shown. The normal hierarchy was assumed, with oscillation parameters give the values listed in table\nobreakspace  {}\ref  {tab:osc_params_fixed_values_reactor}. These numbers were calculated for an exposure of 4.0108$\times $10$^{20}$POT. \relax }}{8}{table.caption.3}}
\newlabel{tab:nsk_nominal_osc}{{3}{8}{Calculated predicted numbers of 1-ring $e$-like events with oscillations using the nominal MC templates, the NA61-tuned MC templates, the NIWG-tuned MC templates and the BANFF-tuned MC templates. The BANFF prefit column is the NA61 tuned data, with the CCQE samples reweighted according to the NIWG's external data fits~\cite {NIWGCCQE}. The total numbers of events and the numbers of events from each mode considered in this analysis are shown. The normal hierarchy was assumed, with oscillation parameters give the values listed in table~\ref {tab:osc_params_fixed_values_reactor}. These numbers were calculated for an exposure of \TotalPot POT. \relax }{table.caption.3}{}}
