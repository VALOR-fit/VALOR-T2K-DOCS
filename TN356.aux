\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces  Treatment of the oscillation parameters in the $\bar {\nu }_{e}$ appearance analysis. All the gaussian priors are from \cite  {pdg_2018}. The parameter $\qopname  \relax o{sin}^{2} 2 \theta _{13}$ is constrained with the measurement of reactor experiments using the Gaussian prior \cite  {pdg_2018}. The nominal values of $\qopname  \relax o{sin}^2 2 \theta _{13}$, $\qopname  \relax o{sin}^2 2 \theta _{12}$ and $\Delta m^2_{21}$ are from \cite  {pdg_2018}, while all the other oscillation parameter values corresponds to the most probable values obtained by the Bayesian analysis on the T2K run 1-4 neutrino mode data \cite  {T2KLongPaper}. When generating fake-data toys used to fill the test-statistic distributions, the parameters that are thrown according to flat prior probability distributions have a restricted range compared to the priors used when generating marginalisation toys. This is purely to decrease the required CPU time when generating fake-data toys whilst having minimal impact on the p-values produced. This is detailed in appendix \ref  {app:priors}. \relax }}{6}{table.caption.2}}
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:osc_param_priors_nuebarapp_optimised}{{1}{6}{Treatment of the oscillation parameters in the $\nueb $ appearance analysis. All the gaussian priors are from \cite {pdg_2018}. The parameter $\sin ^{2} 2 \theta _{13}$ is constrained with the measurement of reactor experiments using the Gaussian prior \cite {pdg_2018}. The nominal values of $\sin ^2 2 \theta _{13}$, $\sin ^2 2 \theta _{12}$ and $\Delta m^2_{21}$ are from \cite {pdg_2018}, while all the other oscillation parameter values corresponds to the most probable values obtained by the Bayesian analysis on the T2K run 1-4 neutrino mode data \cite {T2KLongPaper}. When generating fake-data toys used to fill the test-statistic distributions, the parameters that are thrown according to flat prior probability distributions have a restricted range compared to the priors used when generating marginalisation toys. This is purely to decrease the required CPU time when generating fake-data toys whilst having minimal impact on the p-values produced. This is detailed in appendix \ref {app:priors}. \relax }{table.caption.2}{}}
\newlabel{tab:osc_param_priors_nuebarapp_optimised@cref}{{[table][1][]1}{[1][6][]6}}
